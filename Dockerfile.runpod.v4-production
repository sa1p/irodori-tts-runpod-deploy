FROM s41t0h/irodori-tts-kohaku-api:20260801-readiness-watchdog-hotfix@sha256:22a0f3018ab5dff5fcc8369893e764ac514a132d120cf62403e0881accf6ede9

ENV HF_HOME=/opt/huggingface-cache
ENV IRODORI_MODEL_REGISTRY=/opt/irodori_artifacts/configs/model_registry.runpod.json
ENV IRODORI_PRELOAD_MODELS=true
ENV IRODORI_WARMUP_SECONDS=off
ENV IRODORI_CUDA_GRAPH=false
ENV NVIDIA_DISABLE_REQUIRE=false
ENV NVIDIA_REQUIRE_CUDA="cuda>=12.8"

WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --extra cu128

COPY irodori_tts ./irodori_tts
COPY api_server.py infer.py ./

RUN uv run --no-sync python -c "from huggingface_hub import snapshot_download; snapshot_download('Aratako/Irodori-TTS-v4-Small', local_dir='/opt/irodori_artifacts/models/Irodori-TTS-v4-Small'); snapshot_download('sbintuitions/modernbert-ja-310m'); snapshot_download('Aratako/Semantic-DACVAE-Japanese-32dim')"

RUN cp /opt/irodori_artifacts/configs/model_registry.runpod.json /opt/irodori_artifacts/configs/model_registry.v3.rollback.json \
    && sed 's#/models/Irodori-TTS-500M-v3/model.safetensors#/models/Irodori-TTS-v4-Small/model.safetensors#g' \
        /opt/irodori_artifacts/configs/model_registry.v3.rollback.json \
        > /opt/irodori_artifacts/configs/model_registry.runpod.json

LABEL org.opencontainers.image.title="Irodori-TTS v4 Small production worker"
LABEL org.opencontainers.image.revision="8ca3acb58ab4e19ad6d594aaed6bafe3e88f7f71"

CMD ["/app/scripts/runpod_start_lb.sh"]
