FROM s41t0h/irodori-tts-kohaku-api:20260706-watchdog-lb

# RunPod's RTX 4090 pool currently includes driver 550 hosts. Replace the
# inherited CUDA 12.8 PyTorch stack with the latest official cu124 build that
# supports those hosts. TorchCodec 0.2 is the matching release for Torch 2.6.
RUN uv pip install --python /app/.venv/bin/python --reinstall \
        --index-url https://download.pytorch.org/whl/cu124 \
        "torch==2.6.0+cu124" "torchaudio==2.6.0+cu124" \
    && uv pip install --python /app/.venv/bin/python --reinstall --no-deps \
        "torchcodec==0.2.0"

ENV NVIDIA_DISABLE_REQUIRE="true"
ENV NVIDIA_REQUIRE_CUDA="cuda>=12.4"

COPY api_server.py /app/api_server.py
COPY irodori_tts/inference_runtime.py /app/irodori_tts/inference_runtime.py
COPY irodori_tts/microbatch.py /app/irodori_tts/microbatch.py
COPY scripts/runpod_start_4090_lb.sh /app/scripts/runpod_start_4090_lb.sh

RUN chmod +x /app/scripts/runpod_start_4090_lb.sh

CMD ["/app/scripts/runpod_start_4090_lb.sh"]
